# Python
.venv/
__pycache__/
*.pyc

# External tool clones (tracked upstream, not here).
# tools/* rather than tools/ so our own code under tools/ can be re-included --
# git cannot re-include anything inside an excluded *directory*.
tools/*
!tools/c166/
!tools/newtiburon/
!tools/raw_logger.py
!tools/ram_logger.py

# GKFlasher default read output if accidentally dumped in root
output_*.bin
# solved PoW cookie for newtiburon.com (per-machine, 1 h)
tools/newtiburon/state.json
